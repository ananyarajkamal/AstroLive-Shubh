# ==================================================
# AstroLive Vahan — Backend Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to Git.
# ==================================================

# ── Geocoding ──────────────────────────────────────
# Geoapify free-tier API key (server-side only, NEVER expose to frontend)
GEOAPIFY_API_KEY=

# ── Database ───────────────────────────────────────
# Supabase project URL (format: https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase service-role key (full DB access — server-side ONLY)
# This key MUST NEVER appear in frontend code, NEXT_PUBLIC_* vars,
# API responses, browser JS, or logs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Application ────────────────────────────────────
# Random 32-char secret for request signing/future JWT use
SECRET_KEY=change-me-to-a-long-random-secret

# Environment: development | production
ENVIRONMENT=development

# ── CORS ───────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# No trailing slash. No wildcards in production.
ALLOWED_ORIGINS=http://localhost:3000
